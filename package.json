{
  "name": "arateki-monorepo",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.17.1",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "pnpm --filter @arateki/web dev",
    "build": "pnpm --filter @arateki/web build",
    "lint": "pnpm --filter @arateki/web lint",
    "test": "pnpm --filter @arateki/web test",
    "test:watch": "pnpm --filter @arateki/web test:watch",
    "test:coverage": "pnpm --filter @arateki/web test:coverage",
    "test:e2e": "pnpm --filter @arateki/web test:e2e",
    "test:all": "pnpm --filter @arateki/web test:all",
    "test:ui": "pnpm --filter @arateki/web test:ui",
    "preview": "pnpm --filter @arateki/web preview",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7"
  }
}
