[Unit]
Description=Arateki API (Rust + SQLite, bare-metal)
After=network.target

[Service]
Type=simple
User=arateki
WorkingDirectory=/opt/arateki
ExecStart=/opt/arateki/bin/arateki-api
EnvironmentFile=/etc/arateki/api.env
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/arateki
PrivateTmp=true

[Install]
WantedBy=multi-user.target
